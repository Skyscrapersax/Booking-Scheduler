# Copy into private environment settings; never commit populated credentials.
# Use a separate database and secrets for each app AND for preview/production.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require'
BOOKING_SECRET=
BOOKING_PASSWORD=
BOOKING_HOST=
BOOKING_TIMEZONE=America/New_York
# Secure cookies stay enabled on Vercel. No COOKIE_SECURE=0 in hosted environments.
